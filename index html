 <div class="layout"><nav class="sidebar"><button class="nav active" data-tab="overview" onclick="tab('overview',this)">📊 Visão geral</button><button class="nav" data-tab="create" onclick="tab('create',this)">✨ Criar campanha</button><button class="nav" data-tab="manage" onclick="tab('manage',this)">📚 Minhas campanhas</button><button class="nav" data-tab="moderate" onclick="tab('moderate',this)">🛡️ Moderar ideias</button></nav>
 <main class="main">
  <section id="tab-overview" class="adminTab"><div class="stats"><div class="stat"><span>Campanhas criadas</span><strong id="statCampaigns">0</strong></div><div class="stat"><span>Ideias recebidas</span><strong id="statIdeas">0</strong></div><div class="stat"><span>Ideias aguardando revisão</span><strong id="statPending">0</strong></div></div><div class="panel"><div class="sectionhead"><h2>Campanhas recentes</h2><button class="btn small" onclick="tab('create')">+ Nova campanha</button></div><div id="recentCampaigns" class="campaignlist"></div></div></section>
  <section id="tab-create" class="adminTab hidden"><div class="panel"><div class="sectionhead"><h2>Criar uma campanha</h2><span class="tag">Página exclusiva</span></div><form id="createForm"><div class="formgrid"><div class="field full"><label for="cTitle">Nome da campanha *</label><input id="cTitle" required placeholder="Ex.: Outubro Rosa — Aluno Protagonista"></div><div class="field"><label for="cEmoji">Emoji da campanha</label><select id="cEmoji"><option value="🌷">🌷 Flor</option><option value="💗">💗 Coração</option><option value="🌎">🌎 Meio ambiente</option><option value="♻️">♻️ Reciclagem</option><option value="📚">📚 Leitura e estudos</option><option value="🎨">🎨 Arte e criatividade</option><option value="🤝">🤝 União e respeito</option><option value="🧠">🧠 Saúde e bem-estar</option><option value="🩷">🩷 Outubro Rosa / cuidado</option><option value="✨">✨ Ideias e protagonismo</option><option value="🎗️">🎗️ Conscientização</option><option value="🏆">🏆 Desafio e conquista</option><option value="🎉">🎉 Evento e celebração</option><option value="✏️">✏️ Personalizado abaixo</option></select></div><div class="field"><label for="cEmojiCustom">Ou digite seu próprio emoji</label><input id="cEmojiCustom" maxlength="12" placeholder="Ex.: 🦋 🌻 💙"></div><div class="field full"><label for="cDesc">Apresentação e objetivo *</label><textarea id="cDesc" required placeholder="Explique a campanha, por que ela é importante e o que os alunos podem sugerir."></textarea></div><div class="field"><label for="cStart">Início das participações</label><input id="cStart" type="date"></div><div class="field"><label for="cEnd">Encerramento</label><input id="cEnd" type="date"></div><div class="field"><label for="cAudience">Público participante</label><select id="cAudience"><option>Toda a escola</option><option>Ensino Fundamental</option><option>Ensino Médio</option><option>Turmas específicas</option></select></div><div class="field"><label for="cVote">Votação</label><select id="cVote"><option value="yes">Ativada após aprovação das ideias</option><option value="no">Desativada</option></select></div><div class="field full"><label>Personalizar as cores desta campanha</label><div class="color-options"><label class="color-field" for="cColorPrimary"><input id="cColorPrimary" type="color" value="#d96e9f"><span><b>Cor principal</b><br><span class="smalltext">Botões e destaques</span></span></label><label class="color-field" for="cColorBg"><input id="cColorBg" type="color" value="#fff0f6"><span><b>Cor de fundo</b><br><span class="smalltext">Fundo da apresentação</span></span></label></div><div id="campaignColorPreview" class="color-preview" style="background:linear-gradient(120deg,#fff0f6,#f4f0ff);"><strong>Prévia da campanha</strong><span class="smalltext">As cores escolhidas serão usadas na página dos alunos.</span><div style="margin-top:10px"><span id="campaignColorSample" class="btn small" style="display:inline-block;background:#d96e9f">Exemplo de botão</span></div></div></div><div class="field full"><label for="cRules">Orientações para os alunos</label><textarea id="cRules" placeholder="Ex.: envie uma ideia respeitosa, viável e relacionada ao tema. A escola analisará as propostas antes de publicá-las."></textarea></div><div class="field full"><label for="cFile">Importar arquivo de apoio (opcional)</label><input id="cFile" type="file" accept=".csv,.txt,.json,.pdf,.png,.jpg,.jpeg"><span id="cFileStatus" class="smalltext">Nenhum arquivo selecionado.</span><span class="smalltext">O arquivo será disponibilizado aos alunos na página da campanha (máximo de 2 MB nesta versão). Imagens serão exibidas na página; outros arquivos poderão ser abertos ou baixados.</span></div></div><button class="btn" type="submit">Criar campanha e gerar link →</button></form><div id="newLink" class="hidden"><hr><h3>Link da campanha criado</h3><p class="muted">Copie o link e compartilhe com os alunos. No protótipo, o link funciona no mesmo navegador/dispositivo.</p><div class="linkbox"><input id="linkOutput" readonly><button class="btn" onclick="copyLink()">Copiar link</button><button class="btn secondary" onclick="openLink()">Abrir página</button></div></div></div></section>
  <section id="tab-manage" class="adminTab hidden"><div class="panel"><div class="sectionhead"><h2>Minhas campanhas</h2><span class="smalltext">Cada campanha tem link próprio</span></div><div id="allCampaigns" class="campaignlist"></div></div></section>
  <section id="tab-moderate" class="adminTab hidden"><div class="panel"><div class="sectionhead"><h2>Revisão de ideias</h2><span class="tag orange">Antes de publicar</span></div><p class="muted">As propostas ficam privadas até a escola aprová-las. Por isso, uma ideia enviada não aparece imediatamente no mural público: entre em “Moderar ideias” e clique em “Aprovar e publicar”. Revise conteúdo e dados pessoais antes de liberar.</p><div id="moderationList" class="ideas"></div></div></section>
 </main></div>
</section>
<section id="public" class="hidden">
 <div class="publichead"><span class="smalltext">Página de participação dos alunos</span></div>
 <div id="publicCampaign"></div>
 <div class="cards" style="margin-top:18px">
  <div class="panel"><h2>💡 Compartilhe sua ideia</h2><p class="muted">Conte sua proposta com clareza. Ela só aparecerá no blog depois da revisão da escola.</p><form id="ideaForm"><input id="ideaCampaignId" type="hidden"><div class="field"><label for="ideaName">Como podemos chamar você? *</label><input id="ideaName" required maxlength="60" placeholder="Nome ou apelido autorizado pela escola"></div><div class="field"><label for="ideaClass">Sala / turma *</label><input id="ideaClass" required maxlength="40" placeholder="Ex.: 8º A, 2º B ou Sala 12"></div><div class="field"><label for="ideaTitle">Título da ideia *</label><input id="ideaTitle" required maxlength="100" placeholder="Ex.: Mural de mensagens de apoio"></div><div class="field"><label for="ideaBody">Explique sua proposta *</label><textarea id="ideaBody" required maxlength="1500" placeholder="O que você sugere? Como poderia funcionar?"></textarea></div><div class="field"><label for="ideaImage">Imagem da campanha (opcional)</label><input id="ideaImage" type="file" accept="image/png,image/jpeg,image/webp,image/gif"><span class="smalltext">Envie um cartaz ou imagem da sua campanha (PNG, JPG ou WEBP; até 5 MB). A imagem será reduzida para facilitar o envio. Não envie fotos de alunos sem autorização.</span></div><button class="btn" type="submit">Enviar para análise →</button><p class="smalltext">Não inclua telefone, endereço, informações íntimas ou dados de outras pessoas.</p></form><div id="ideaSuccess" class="notice info hidden">Sua ideia foi enviada para análise da escola. Obrigado por participar! 🌷</div></div>
  <div class="panel"><div class="sectionhead"><h2>🗳️ Ideias da comunidade</h2><span class="tag green">Aprovadas</span></div><p class="muted">Leia as propostas e vote naquelas que você gostaria de apoiar.</p><div id="publicIdeas" class="ideas"></div></div>
 </div>
 <div class="notice info">A votação é consultiva: as ideias mais votadas serão levadas à análise da equipe escolar e, quando necessário, da secretaria responsável. A votação não garante que a proposta será executada.</div>
</section>
</div>
<script>
const STORE='vivaAlunoProtagonista_v1';
let data=loadData(), currentCampaign=null, lastLink='';
function loadData(){try{return JSON.parse(localStorage.getItem(STORE))||{campaigns:[],ideas:[],votes:[]}}catch(e){return{campaigns:[],ideas:[],votes:[]}}}
function save(){localStorage.setItem(STORE,JSON.stringify(data));refresh()}
function id(){return 'camp-'+Date.now().toString(36)+'-'+Math.random().toString(36).slice(2,7)}
function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function fmt(d){if(!d)return '';try{return new Date(d+'T12:00:00').toLocaleDateString('pt-BR')}catch(e){return d}}
function showOnly(which){['home','admin','public'].forEach(x=>document.getElementById(x).classList.toggle('hidden',x!==which));document.getElementById('homeBtn').classList.toggle('hidden',which!=='admin')}
function goHome(){adminUnlocked=false;history.pushState({},'',location.pathname+location.search);showOnly('home');refresh()}
function showAdmin(){
 const pin=prompt('Área restrita à equipe escolar. Digite a senha de acesso:');
 if(pin===null)return;
 if(pin!==localStorage.getItem('vivaAdminPin') && localStorage.getItem('vivaAdminPin')!==null){alert('Senha incorreta.');return;}
 if(localStorage.getItem('vivaAdminPin')===null){
   const newPin=prompt('Crie uma senha para proteger o painel neste navegador (não substitui autenticação online):');
   if(!newPin||newPin.trim().length<4){alert('Use uma senha com pelo menos 4 caracteres.');return;}
   localStorage.setItem('vivaAdminPin',newPin.trim());
 }
 adminUnlocked=true;history.pushState({},'',location.pathname+location.search+'#escola');showOnly('admin');tab('overview');refresh()
}
function tab(name,btn){document.querySelectorAll('.adminTab').forEach(x=>x.classList.add('hidden'));document.getElementById('tab-'+name).classList.remove('hidden');document.querySelectorAll('.nav').forEach(x=>x.classList.toggle('active',x.dataset.tab===name));if(btn)btn.classList.add('active');if(name==='moderate')renderModeration()}
function publicBaseUrl(){
 const canonical=document.querySelector('link[rel=\"canonical\"]');
 if(canonical&&/^https?:$/.test(new URL(canonical.href).protocol))return canonical.href.split('#')[0];
 if(/^https?:$/.test(location.protocol))return new URL(location.pathname+location.search,location.origin).href.split('#')[0];
 return '';
}
function linkFor(c){
 const base=publicBaseUrl();
 if(!base||!c)return '';
 // Inclui os dados básicos da campanha no próprio link para que ela abra
 // também em outro celular, mesmo sem existir no armazenamento local dele.
 // Arquivos anexados não entram no link para evitar endereços enormes.
 const shared={...c,fileData:'',fileName:c.fileName||'',fileType:''};
 const encoded=btoa(unescape(encodeURIComponent(JSON.stringify(shared))))
   .replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'');
 return base+'#campanha='+encodeURIComponent(c.id)+'&dados='+encoded;
}
function explainLocalLink(){alert('Abra o aplicativo pelo endereço publicado no GitHub Pages (https://...). Depois crie ou copie a campanha. O link será gerado automaticamente.');}
function restoreCampaignFromLink(){
 try{
  const raw=location.hash.slice(1);
  const params=new URLSearchParams(raw);
  if(params.get('campanha')===null||!params.get('dados'))return null;
  let encoded=params.get('dados').replace(/-/g,'+').replace(/_/g,'/');
  while(encoded.length%4)encoded+='=';
  const shared=JSON.parse(decodeURIComponent(escape(atob(encoded))));
  if(!shared||!shared.id||shared.id!==params.get('campanha'))return null;
  const idx=data.campaigns.findIndex(x=>x.id===shared.id);
  if(idx>=0)data.campaigns[idx]={...data.campaigns[idx],...shared};
  else data.campaigns.push(shared);
  save();
  return shared.id;
 }catch(e){return null;}
}
function createCard(c,admin=false){let count=data.ideas.filter(i=>i.campaignId===c.id).length;let status=c.active===false?'Arquivada':'Ativa';return `<article class="campaign" style="border-top:4px solid ${esc(c.colorPrimary||'#d96e9f')}"><div class="campaign-top"><span class="tag ${c.active===false?'orange':'green'}">${status}</span><span class="smalltext">${esc(c.audience||'Toda a escola')}</span></div><h3>${esc(c.emoji||'🌷')} ${esc(c.title)}</h3><p>${esc(c.desc)}</p><div class="smalltext">${c.start?'Início: '+fmt(c.start)+' · ':''}${c.end?'Fim: '+fmt(c.end)+' · ':''}${count} ideia(s)</div>${admin?`<div class="btnrow"><button class="btn small" onclick="showCampaign('${c.id}')">Abrir página</button><button class="btn secondary small" onclick="copyCampaign('${c.id}')">Copiar link</button><button class="btn secondary small" onclick="toggleCampaign('${c.id}')">${c.active===false?'Reativar':'Arquivar'}</button></div>`:`<div class="btnrow"><button class="btn small" onclick="showCampaign('${c.id}')">Participar →</button></div>`}</article>`}
function refresh(){let active=data.campaigns.filter(c=>c.active!==false);document.getElementById('statCampaigns').textContent=data.campaigns.length;document.getElementById('statIdeas').textContent=data.ideas.length;document.getElementById('statPending').textContent=data.ideas.filter(i=>i.status==='pending').length;document.getElementById('recentCampaigns').innerHTML=active.length?active.slice(-3).reverse().map(c=>createCard(c,true)).join(''):'<div class="empty">Ainda não há campanhas. Crie a primeira!</div>';document.getElementById('allCampaigns').innerHTML=data.campaigns.length?data.campaigns.slice().reverse().map(c=>createCard(c,true)).join(''):'<div class="empty">Nenhuma campanha criada.</div>';renderModeration()}
document.getElementById('createForm').addEventListener('submit',async e=>{e.preventDefault();const form=e.target;const submitBtn=form.querySelector('button[type="submit"]');const file=document.getElementById('cFile').files[0];if(file&&file.size>2*1024*1024){alert('O arquivo de apoio deve ter no máximo 2 MB para caber no armazenamento deste protótipo.');return;}submitBtn.disabled=true;submitBtn.textContent='Criando campanha...';try{let fileData='';if(file)fileData=await new Promise((resolve,reject)=>{const reader=new FileReader();reader.onload=()=>resolve(String(reader.result));reader.onerror=()=>reject(new Error('Falha ao ler arquivo'));reader.readAsDataURL(file)});let c={id:id(),title:document.getElementById('cTitle').value.trim(),emoji:(document.getElementById('cEmojiCustom').value.trim()||document.getElementById('cEmoji').value||'🌷'),desc:document.getElementById('cDesc').value.trim(),start:document.getElementById('cStart').value,end:document.getElementById('cEnd').value,audience:document.getElementById('cAudience').value,voting:document.getElementById('cVote').value==='yes',rules:document.getElementById('cRules').value.trim(),colorPrimary:document.getElementById('cColorPrimary').value,colorBg:document.getElementById('cColorBg').value,fileName:file?file.name:'',fileData,fileType:file?file.type:'',created:new Date().toISOString(),active:true};data.campaigns.push(c);try{save()}catch(storageErr){data.campaigns=data.campaigns.filter(x=>x.id!==c.id);alert('Não foi possível salvar. Tente um arquivo menor (até 2 MB) ou crie a campanha sem arquivo.');return;}lastLink=linkFor(c);if(!lastLink){document.getElementById('newLink').classList.add('hidden');explainLocalLink();}else{document.getElementById('linkOutput').value=lastLink;document.getElementById('newLink').classList.remove('hidden');}form.reset();updateCampaignColorPreview();}catch(err){alert('Não foi possível ler o arquivo de apoio. Tente outro arquivo.')}finally{submitBtn.disabled=false;submitBtn.textContent='Criar campanha e gerar link →';}});
function copyLink(){let el=document.getElementById('linkOutput');el.select();el.setSelectionRange(0,99999);if(navigator.clipboard&&navigator.clipboard.writeText)navigator.clipboard.writeText(el.value).then(()=>alert('Link copiado!')).catch(()=>alert('Selecione e copie o link manualmente.'));else alert('Link selecionado. Copie usando o menu do dispositivo.')}
function openLink(){let c=data.campaigns.find(x=>linkFor(x)===lastLink)||data.campaigns[data.campaigns.length-1];if(c)showCampaign(c.id)}
function copyCampaign(cid){lastLink=linkFor(data.campaigns.find(c=>c.id===cid));if(!lastLink){explainLocalLink();return;}if(navigator.clipboard&&navigator.clipboard.writeText)navigator.clipboard.writeText(lastLink).then(()=>alert('Link copiado!')).catch(()=>prompt('Copie o link:',lastLink));else prompt('Copie o link:',lastLink)}
function toggleCampaign(cid){let c=data.campaigns.find(c=>c.id===cid);if(c){c.active=c.active===false;save()}}
function showCampaign(cid){let c=data.campaigns.find(c=>c.id===cid);if(!c){alert('Campanha não encontrada neste navegador.');return}currentCampaign=c;document.getElementById('public').style.setProperty('--campaign-primary',c.colorPrimary||'#d96e9f');document.getElementById('public').style.setProperty('--campaign-bg',c.colorBg||'#fff0f6');history.pushState({},'',location.pathname+location.search+'#campanha='+encodeURIComponent(cid));showOnly('public');document.getElementById('ideaCampaignId').value=cid;document.getElementById('ideaSuccess').classList.add('hidden');document.getElementById('publicCampaign').innerHTML=`<div class="hero" style="background:linear-gradient(120deg,${esc(c.colorBg||'#fff0f6')},#f4f0ff 65%,#effaf4);border-top:5px solid ${esc(c.colorPrimary||'#d96e9f')}"><span class="eyebrow" style="color:${esc(c.colorPrimary||'#ba5d8a')}">Escola Estadual Heloíza Therezinha Murbach Lacava · Aluno protagonista</span><h1 class="publictitle">${esc(c.emoji||'🌷')} ${esc(c.title)}</h1><p>${esc(c.desc)}</p><div class="btnrow"><span class="pill">👥 ${esc(c.audience||'Toda a escola')}</span>${c.end?`<span class="pill">📅 Até ${fmt(c.end)}</span>`:''}</div></div>${c.rules?`<div class="notice info"><b>Orientações:</b> ${esc(c.rules)}</div>`:''}<div class="smalltext">${c.voting?'A votação está disponível para as ideias aprovadas.':'A votação está desativada nesta campanha.'} ${c.fileName?'Arquivo de apoio: '+esc(c.fileName):''}</div>${(c.fileData||c.fileName)?`<div class="panel" style="margin-top:14px"><h2>📎 Material de apoio da escola</h2><p class="muted">${esc(c.fileName||'Arquivo de apoio')}</p>${!c.fileData?`<div class="notice">O nome foi salvo, mas o conteúdo do arquivo não está nesta campanha. Anexe o material novamente pelo painel administrativo.</div>`:''}${c.fileData&&(c.fileType||'').startsWith('image/')?`<img src="${c.fileData}" alt="Material de apoio da campanha" style="display:block;width:100%;max-width:760px;max-height:520px;object-fit:contain;object-position:left;border-radius:12px;margin:10px 0">`:''}${c.fileData&&(c.fileType||'').includes('pdf')?`<iframe title="Visualização do PDF de apoio" src="${c.fileData}" style="width:100%;height:600px;border:1px solid var(--line);border-radius:12px;margin:10px 0"></iframe>`:''}${c.fileData?`<div class="btnrow"><a class="btn" href="${c.fileData}" target="_blank" rel="noopener" style="text-decoration:none;display:inline-block">Abrir arquivo ↗</a><a class="btn secondary" href="${c.fileData}" download="${esc(c.fileName||'material-de-apoio')}" style="text-decoration:none;display:inline-block">Baixar arquivo ↓</a></div>`:''}</div>`:''}`;renderPublicIdeas()}
async function imageToCompactDataUrl(file){return new Promise((resolve,reject)=>{const reader=new FileReader();reader.onerror=()=>reject(new Error('Não foi possível ler a imagem.'));reader.onload=()=>{const img=new Image();img.onerror=()=>reject(new Error('Formato de imagem inválido.'));img.onload=()=>{const maxSide=1200;const scale=Math.min(1,maxSide/Math.max(img.width,img.height));const canvas=document.createElement('canvas');canvas.width=Math.max(1,Math.round(img.width*scale));canvas.height=Math.max(1,Math.round(img.height*scale));const ctx=canvas.getContext('2d');ctx.drawImage(img,0,0,canvas.width,canvas.height);resolve(canvas.toDataURL('image/jpeg',0.72));};img.src=String(reader.result);};reader.readAsDataURL(file);});}
document.getElementById('ideaForm').addEventListener('submit',async e=>{e.preventDefault();let cid=document.getElementById('ideaCampaignId').value;let c=data.campaigns.find(c=>c.id===cid);if(!c){alert('Campanha não encontrada. Abra novamente o link da campanha.');return;}const submitBtn=e.target.querySelector('button[type="submit"]');submitBtn.disabled=true;submitBtn.textContent='Enviando...';try{const imageFile=document.getElementById('ideaImage').files[0];if(imageFile&&imageFile.size>5*1024*1024){alert('A imagem original deve ter no máximo 5 MB.');return;}let image='';if(imageFile)image=await imageToCompactDataUrl(imageFile);const idea={id:id(),campaignId:cid,name:document.getElementById('ideaName').value.trim(),classroom:document.getElementById('ideaClass').value.trim(),title:document.getElementById('ideaTitle').value.trim(),body:document.getElementById('ideaBody').value.trim(),image,status:'pending',created:new Date().toISOString()};data.ideas.push(idea);try{save();}catch(storageErr){data.ideas=data.ideas.filter(i=>i.id!==idea.id);alert('O navegador ficou sem espaço para salvar esta ideia. Tente uma imagem menor ou sem imagem.');return;}e.target.reset();document.getElementById('ideaSuccess').textContent='Sua ideia foi enviada e salva! Ela aparecerá no mural para todos depois que a escola aprovar. Você pode acompanhar com a equipe escolar.';document.getElementById('ideaSuccess').classList.remove('hidden');document.getElementById('ideaCampaignId').value=cid;}catch(err){alert('Não foi possível enviar a ideia. Tente outra imagem ou envie sem imagem.');}finally{submitBtn.disabled=false;submitBtn.textContent='Enviar para análise →';}});
function renderPublicIdeas(){if(!currentCampaign)return;let ideas=data.ideas.filter(i=>i.campaignId===currentCampaign.id&&i.status==='approved');document.getElementById('publicIdeas').innerHTML=ideas.length?ideas.sort((a,b)=>voteCount(b.id)-voteCount(a.id)).map(i=>`<article class="idea"><div class="idea-top"><div><h3>${esc(i.emoji||'💡')} ${esc(i.title)}</h3><div class="smalltext">Por ${esc(i.name)} · Sala/turma: ${esc(i.classroom||'Não informada')}</div></div><span class="tag green">Publicada</span></div><p>${esc(i.body)}</p>${i.image?`<img src="${i.image}" alt="Imagem da campanha enviada por ${esc(i.name)}" style="display:block;max-width:100%;max-height:420px;object-fit:contain;border-radius:12px;margin-top:10px;border:1px solid var(--line)">`:''}<div class="idea-footer"><span class="smalltext">${voteCount(i.id)} voto(s)</span>${currentCampaign.voting?`<div class="vote"><button class="${hasVoted(i.id)?'voted':''}" onclick="vote('${i.id}')">${hasVoted(i.id)?'✓ Votou':'♡ Votar'}</button></div>`:'<span class="smalltext">Votação encerrada/desativada</span>'}</div></article>`).join(''):'<div class="empty">As ideias aprovadas aparecerão aqui. Seja a primeira pessoa a enviar uma proposta! 💗</div>'}
function voteCount(iid){return data.votes.filter(v=>v.ideaId===iid).length}
function hasVoted(iid){return data.votes.some(v=>v.ideaId===iid&&v.voter===visitorKey())}
function visitorKey(){let k='vivaVisitorKey';let v=sessionStorage.getItem(k);if(!v){v='visitor-'+Math.random().toString(36).slice(2);sessionStorage.setItem(k,v)}return v}
function vote(iid){if(hasVoted(iid)){alert('Neste navegador, você já votou nesta ideia.');return}data.votes.push({ideaId:iid,voter:visitorKey(),created:new Date().toISOString()});save();renderPublicIdeas()}
function renderModeration(){let pending=data.ideas.filter(i=>i.status==='pending');document.getElementById('moderationList').innerHTML=pending.length?pending.map(i=>{let c=data.campaigns.find(c=>c.id===i.campaignId);return `<article class="idea"><div class="idea-top"><div><span class="tag orange">Aguardando revisão</span><h3>${esc(i.emoji||'💡')} ${esc(i.title)}</h3><div class="smalltext">Por ${esc(i.name)} · Sala/turma: ${esc(i.classroom||'Não informada')} · Campanha: ${esc(c?c.title:'não encontrada')}</div></div></div><p>${esc(i.body)}</p>${i.image?`<img src="${i.image}" alt="Imagem enviada com a ideia" style="display:block;max-width:100%;max-height:360px;object-fit:contain;border-radius:12px;margin-top:10px;border:1px solid var(--line)">`:''}<div class="btnrow"><button class="btn small" onclick="moderate('${i.id}','approved')">✓ Aprovar e publicar</button><button class="btn danger small" onclick="moderate('${i.id}','rejected')">Recusar</button></div></article>`}).join(''):'<div class="empty">Tudo em dia! Não há ideias aguardando revisão.</div>';let all=data.ideas.filter(i=>i.status!=='pending');if(all.length)document.getElementById('moderationList').innerHTML+=`<hr><h3>Decisões anteriores</h3>`+all.slice().reverse().map(i=>`<article class="idea"><div class="idea-top"><h3>${esc(i.title)}</h3><span class="tag ${i.status==='approved'?'green':'orange'}">${i.status==='approved'?'Aprovada':'Recusada'}</span></div><p>${esc(i.body)}</p>${i.status==='rejected'?`<button class="btn secondary small" onclick="moderate('${i.id}','pending')">Voltar para revisão</button>`:''}</article>`).join('')}
function moderate(iid,status){let i=data.ideas.find(i=>i.id===iid);if(i){i.status=status;save();renderModeration();if(currentCampaign)renderPublicIdeas()}}
window.addEventListener('hashchange',route);window.addEventListener('popstate',route);
let adminUnlocked=false;
function route(){const restored=restoreCampaignFromLink();if(restored){showCampaign(restored);return;}let h=location.hash.slice(1);if(h.startsWith('campanha=')){const cid=new URLSearchParams(h).get('campanha');if(cid)showCampaign(cid);else{showOnly('home');refresh();}}else if(h==='escola'&&adminUnlocked){showOnly('admin');refresh()}else{showOnly('home');refresh()}}
function updateCampaignColorPreview(){const primary=document.getElementById('cColorPrimary');const bg=document.getElementById('cColorBg');const preview=document.getElementById('campaignColorPreview');const sample=document.getElementById('campaignColorSample');if(primary&&bg&&preview&&sample){sample.style.background=primary.value;preview.style.background=`linear-gradient(120deg,${bg.value},#f4f0ff 65%,#effaf4)`;preview.style.borderTop='4px solid '+primary.value;}}
document.getElementById('cFile').addEventListener('change',()=>{const f=document.getElementById('cFile').files[0];document.getElementById('cFileStatus').textContent=f?'Arquivo selecionado: '+f.name+' ('+Math.ceil(f.size/1024)+' KB)':'Nenhum arquivo selecionado.';});document.getElementById('cColorPrimary').addEventListener('input',updateCampaignColorPreview);document.getElementById('cColorBg').addEventListener('input',updateCampaignColorPreview);
refresh();route();updateCampaignColorPreview();
</script>
</body></html>