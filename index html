tn.danger{background:#fff0f0;color:#b74e5b;box-shadow:none}.btn.small{padding:7px 10px;font-size:13px}.btnrow{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px}.hidden{display:none!important}.notice{border-radius:14px;background:#fff8e9;border:1px solid #f6e5bd;color:#775f34;padding:12px 15px;font-size:13px;margin:15px 0}.notice.info{background:#eff7ff;border-color:#d8eaff;color:#45627c}.layout{display:grid;grid-template-columns:235px minmax(0,1fr);gap:18px}.sidebar{align-self:start;background:#fff;border:1px solid var(--line);border-radius:19px;padding:10px;display:grid;gap:5px}.nav{padding:12px;text-align:left;border-radius:11px;background:transparent;color:#706777;font-weight:650}.nav.active,.nav:hover{background:var(--pink2);color:#b24e7e}.main{min-width:0}.stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-bottom:16px}.stat{border:1px solid var(--line);border-radius:16px;padding:16px;background:white}.stat strong{display:block;font-size:27px}.stat span{font-size:12px;color:var(--muted)}.sectionhead{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:15px}.sectionhead h2{margin:0}.field{display:grid;gap:6px;margin-bottom:13px}.field label{font-weight:700;font-size:13px}.field input,.field textarea,.field select,input.search{width:100%;border:1px solid #e8dfe9;border-radius:11px;padding:11px 12px;background:#fff;color:var(--ink);outline-color:#e9a0bf}.field textarea{min-height:105px;resize:vertical}.formgrid{display:grid;grid-template-columns:1fr 1fr;gap:0 14px}.full{grid-column:1/-1}.campaignlist,.ideas{display:grid;gap:12px}.campaign,.idea{border:1px solid var(--line);border-radius:16px;padding:16px;background:#fff}.campaign-top,.idea-top{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}.tag{background:#f4effb;color:#77628e;padding:4px 9px;border-radius:99px;font-size:11px;font-weight:800;white-space:nowrap}.tag.green{background:#e6f7ee;color:#39795c}.tag.orange{background:#fff1dc;color:#916a2e}.campaign h3,.idea h3{margin:7px 0 4px}.campaign p,.idea p{margin:5px 0;color:#746b7b;white-space:pre-wrap}.idea-footer{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-top:13px;padding-top:11px;border-top:1px solid #f2edf3}.vote{display:flex;align-items:center;gap:7px}.vote button{background:color-mix(in srgb,var(--campaign-primary,#fceaf2) 15%,white);color:var(--campaign-primary,#b44f7d);border-radius:10px;padding:8px 11px;font-weight:800}.vote button.voted{background:#dff4e9;color:#326f56}#public{--campaign-primary:#d96e9f;--campaign-bg:#fff0f6;background:color-mix(in srgb,var(--campaign-bg) 22%,white);border-radius:22px;padding:14px}#public .panel{border-color:color-mix(in srgb,var(--campaign-primary) 18%,var(--line));background:color-mix(in srgb,var(--campaign-bg) 16%,white)}#public .panel h2{color:color-mix(in srgb,var(--campaign-primary) 75%,var(--ink))}#public .field input,#public .field textarea,#public .field select{border-color:color-mix(in srgb,var(--campaign-primary) 22%,#e8dfe9)}#public .field input:focus,#public .field textarea:focus,#public .field select:focus{outline-color:var(--campaign-primary)}#public .btn:not(.secondary):not(.mint):not(.danger){background:var(--campaign-primary)}#public .idea{border-color:color-mix(in srgb,var(--campaign-primary) 20%,var(--line));background:color-mix(in srgb,var(--campaign-bg) 10%,white)}#public .notice.info{background:color-mix(in srgb,var(--campaign-bg) 35%,white);border-color:color-mix(in srgb,var(--campaign-primary) 20%,#d8eaff)}.color-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.color-field{display:flex;align-items:center;gap:10px;border:1px solid var(--line);border-radius:12px;padding:10px}.color-field input[type=color]{width:48px;height:38px;border:0;background:transparent;padding:0;cursor:pointer}.color-preview{border-radius:14px;padding:14px;border:1px solid var(--line);margin:5px 0 14px}.color-preview strong{display:block;margin-bottom:4px}@media(max-width:520px){.color-options{grid-template-columns:1fr}}.footer{text-align:center;color:#9a909e;font-size:12px;margin-top:30px}.empty{padding:28px;text-align:center;border:1px dashed #e6dce8;border-radius:15px;color:var(--muted)}.linkbox{display:flex;gap:8px;flex-wrap:wrap}.linkbox input{flex:1;min-width:180px;border:1px solid var(--line);border-radius:10px;padding:10px}.publichead{margin-bottom:18px}.publichead .back{color:#a34c78;font-weight:750;text-decoration:none}.publictitle{font-size:clamp(27px,4vw,38px);margin:8px 0}.smalltext{font-size:12px;color:var(--muted)}hr{border:0;border-top:1px solid var(--line);margin:18px 0}
